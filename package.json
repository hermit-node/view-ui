{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "description": "pnpm/Vue 3 migration workspace draft for Chakra UI Vue",
  "maintainers": [
    "Jonathan Bakebwa <codebender828@gmail.com>"
  ],
  "author": {
    "name": "Jonathan Bakebwa",
    "email": "codebender828@gmail.com",
    "url": "https://jbakebwa.dev"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --if-present run build",
    "build:core": "pnpm --filter @chakra-ui/vue build",
    "dev": "pnpm --filter @chakra-ui/vue dev",
    "theme:dev": "pnpm --filter @chakra-ui/theme-vue build",
    "clean": "pnpm -r --filter './packages/*' --if-present run clean",
    "lint": "eslint packages",
    "test": "pnpm test:core",
    "test:core": "jest",
    "pkg": "manypkg run",
    "pkgs:check": "manypkg check",
    "pkgs:fix": "manypkg fix"
  },
  "dependencies": {
    "@chakra-ui/styled-system": "^1.15.0",
    "@emotion/css": "^11.0.0",
    "@popperjs/core": "^2.11.8",
    "animejs": "^3.2.2",
    "aria-hidden": "^1.2.6",
    "breadstick": "^0.2.14",
    "can-use-dom": "^0.1.0",
    "color": "^5.0.3",
    "copy-to-clipboard": "^3.3.3",
    "core-js": "^3.49.0",
    "cross-env": "^7.0.3",
    "defu": "^6.1.4",
    "dotenv-defaults": "^5.0.2",
    "feather-icons-paths": "^1.0.8",
    "focus-trap": "^7.6.6",
    "lodash-es": "^4.17.21",
    "node-fetch": "^2.7.0",
    "prismjs": "^1.30.0",
    "rimraf": "^6.0.1",
    "v-scroll-lock": "^1.1.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/plugin-transform-object-rest-spread": "^7.28.4",
    "@babel/plugin-transform-optional-chaining": "^7.28.5",
    "@babel/plugin-transform-parameters": "^7.27.7",
    "@babel/preset-env": "^7.28.5",
    "@babel/runtime-corejs3": "^7.28.4",
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@emotion/babel-plugin": "^11.13.5",
    "@emotion/eslint-plugin": "^11.12.0",
    "@emotion/jest": "^11.13.0",
    "@manypkg/cli": "^0.25.1",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@vue/compiler-sfc": "^3.5.0",
    "@vue/test-utils": "^2.4.6",
    "babel-core": "7.0.0-bridge.0",
    "babel-jest": "^30.2.0",
    "babel-loader": "^10.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-testing-library": "^7.13.5",
    "eslint-plugin-vue": "^10.6.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lerna": "^8.2.4",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "rollup": "^4.53.3",
    "rollup-plugin-scss": "^4.0.1",
    "rollup-plugin-vue": "^6.0.0",
    "sass": "^1.97.0",
    "sass-loader": "^16.0.6"
  },
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "design-system",
    "vue-components",
    "uikit",
    "accessible",
    "components",
    "emotion",
    "library"
  ]
}
